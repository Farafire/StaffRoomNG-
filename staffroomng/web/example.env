# Copy this file to .env and fill in your own values.
# Firebase values come from: Firebase Console > Project settings > Your apps > Web app
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Paystack public key (Test key while developing, Live key at launch)
# From: Paystack Dashboard > Settings > API Keys & Webhooks
VITE_PAYSTACK_PUBLIC_KEY=

# Set to "true" to point the app at the local Firebase emulators
VITE_USE_EMULATORS=false
