# These get set as Environment Variables in the Render dashboard,
# not committed as a real .env file.

# Paste your Paystack secret key (Test key while developing)
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxx

# Paste the ENTIRE contents of your Firebase service account JSON file
# as a single line here. See README for how to generate it.
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"staffroomng", ...}
